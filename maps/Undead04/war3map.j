//===========================================================================
function CreateUnitsForPlayer2 takes nothing returns nothing
    local player p= Player(2)
    local unit u
    local integer unitID
    local trigger t
    local real life

    set gg_unit_hpea_0149=CreateUnit(p, 'hpea', - 5230.4, - 4797.5, 85.720)
    set life=GetUnitState(gg_unit_hpea_0149, UNIT_STATE_LIFE)
    call SetUnitState(gg_unit_hpea_0149, UNIT_STATE_LIFE, 0.60 * life)
    set gg_unit_hpea_0150=CreateUnit(p, 'hpea', - 3557.5, - 3248.3, 142.927)
    call IssueImmediateOrder(gg_unit_hpea_0150, "repairoff")
    set gg_unit_hpea_0158=CreateUnit(p, 'hpea', - 6358.2, - 4988.1, 262.367)
    set gg_unit_hpea_0162=CreateUnit(p, 'hpea', - 6118.1, - 5157.0, 53.066)
endfunction

