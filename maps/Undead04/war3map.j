//===========================================================================
// Trigger: Unit Defeat
//===========================================================================
function Trig_Unit_Defeat_Func008001001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Unit_Defeat_Conditions takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(Player(3), Condition(function Trig_Unit_Defeat_Func008001001002))) <= 0 ) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Defeat_Actions takes nothing returns nothing
    set udg_GameOver=true
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Defeat)
    call DisableTrigger(gg_trg_Trigger_Victory)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_FAILED, "TRIGSTR_443")
    call TriggerSleepAction(2.00)
    call CustomDefeatBJ(udg_AAAP_Undead, "TRIGSTR_444")
endfunction

//===========================================================================
function InitTrig_Unit_Defeat takes nothing returns nothing
    set gg_trg_Unit_Defeat=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Unit_Defeat, Player(3), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Unit_Defeat, Condition(function Trig_Unit_Defeat_Conditions))
    call TriggerAddAction(gg_trg_Unit_Defeat, function Trig_Unit_Defeat_Actions)
endfunction

//===========================================================================
// Trigger: Defeat
//===========================================================================
function Trig_Defeat_Conditions takes nothing returns boolean
    if ( not ( GetPlayerStructureCount(Player(3), true) == 0 ) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Actions takes nothing returns nothing
    set udg_GameOver=true
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Unit_Defeat)
    call DisableTrigger(gg_trg_Trigger_Victory)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_FAILED, "TRIGSTR_441")
    call TriggerSleepAction(2.00)
    call CustomDefeatBJ(udg_AAAP_Undead, "TRIGSTR_440")
endfunction

