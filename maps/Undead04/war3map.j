    return ( udg_NumberOfPiecesFound == 2 )
endfunction

function Trig_Key03_Acquired_Func026001 takes nothing returns boolean
    return ( udg_NumberOfPiecesFound == 3 )
endfunction

function Trig_Key03_Acquired_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_NumberOfPiecesFound=( udg_NumberOfPiecesFound + 1 )
    set udg_Key03Acquired=true
    call TriggerSleepAction(0.01)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key02_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key03_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key02_and_Key03_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key2Part_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key02_and_Key2Part_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key03_and_Key2Part_Acquired)
    call TriggerSleepAction(2)
    call SetSpeechVolumeGroupsBJ()
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar03))
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar03), 1.00)
    if ( Trig_Key03_Acquired_Func015001() ) then
        call TransmissionFromUnitTypeWithNameBJ(udg_AAAPG_Undead, udg_AAAP_Undead, 'uktg', "TRIGSTR_182", GetRectCenter(gg_rct_Altar03), gg_snd_U04AKelThuzad10, "TRIGSTR_183", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func016001() ) then
        call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_172", gg_snd_U04AArthas13, "TRIGSTR_173", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func017001() ) then
        call TransmissionFromUnitTypeWithNameBJ(udg_AAAPG_Undead, udg_AAAP_Undead, 'uktg', "TRIGSTR_192", GetRectCenter(gg_rct_Altar03), gg_snd_U04AKelThuzad15, "TRIGSTR_193", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    call VolumeGroupResetBJ()
    if ( Trig_Key03_Acquired_Func019001() ) then
        call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar01), 7.00)
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func020001() ) then
        call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar01))
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func021001() ) then
        call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar02), 7.00)
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func022001() ) then
        call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar02))
    else
        call DoNothing()
    endif
    call TriggerSleepAction(2.00)
    if ( Trig_Key03_Acquired_Func024001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_565")
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func025001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_570")
    else
        call DoNothing()
    endif
    if ( Trig_Key03_Acquired_Func026001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_575")
    else
        call DoNothing()
    endif
    call DestroyFogModifier(udg_Altar03Visibility)
    call ConditionalTriggerExecute(gg_trg___Reveal_Gate_Quest)
endfunction

//===========================================================================
function InitTrig_Key03_Acquired takes nothing returns nothing
    set gg_trg_Key03_Acquired=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Key03_Acquired, Player(3), EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_Key03_Acquired, Condition(function Trig_Key03_Acquired_Conditions))
    call TriggerAddAction(gg_trg_Key03_Acquired, function Trig_Key03_Acquired_Actions)
endfunction

//===========================================================================
// Trigger:   Reveal Gate Quest
//===========================================================================
function Trig___Reveal_Gate_Quest_Conditions takes nothing returns boolean
    if ( not ( udg_NumberOfPiecesFound == 3 ) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig___Reveal_Gate_Quest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetCompletedBJ(udg_QuestKey, true)
    call QuestItemSetCompletedBJ(udg_QuestKeyRequirementPieces, true)
    call QuestSetDiscoveredBJ(udg_QuestGate, true)
    call FlashQuestDialogButtonBJ()
    call TriggerSleepAction(7.00)
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetDestructableLoc(udg_ElfGate02), 512)
    set udg_VisibilityGate=GetLastCreatedFogModifier()
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetDestructableLoc(udg_ElfGate02))
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetDestructableLoc(udg_ElfGate02), 7.00)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_118")
endfunction

//===========================================================================
