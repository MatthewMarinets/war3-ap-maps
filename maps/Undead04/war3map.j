//===========================================================================
// Trigger: SpiderArrival Queue
//===========================================================================
function Trig_SpiderArrival_Queue_Conditions takes nothing returns boolean
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpiderArrival_Queue_Actions takes nothing returns nothing
    call SmartCameraPanBJ(udg_AAAP_Undead, GetUnitLoc(udg_InitialFiendA), 0.5)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_InitialFiendB02))
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), udg_AAAP_Undead, 'ucry', "TRIGSTR_576", GetUnitLoc(udg_InitialFiendA), gg_snd_U04BCryptFiend06, "TRIGSTR_577", bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call RescueUnitBJ(udg_InitialFiendA, udg_AAAP_Undead, true)
    call RescueUnitBJ(udg_InitialFiendB, udg_AAAP_Undead, true)
    call RescueUnitBJ(udg_InitialFiendC, udg_AAAP_Undead, true)
    call IssueImmediateOrderBJ(udg_InitialFiendA, "webon")
    call IssueImmediateOrderBJ(udg_InitialFiendB, "webon")
    call IssueImmediateOrderBJ(udg_InitialFiendC, "webon")
    call TriggerSleepAction(1.00)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_UNITACQUIRED, "TRIGSTR_578")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

