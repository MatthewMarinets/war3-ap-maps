    call IssueImmediateOrderBJ(gg_unit_hpea_0162, "stop")
    call RemoveGuardPosition(gg_unit_nws1_0286)
    call RemoveGuardPosition(gg_unit_nws1_0287)
    call RemoveGuardPosition(gg_unit_nef6_0127)
    call RemoveGuardPosition(gg_unit_nef3_0208)
    call RemoveGuardPosition(gg_unit_nefm_0280)
    // Brown near gate
    call RemoveGuardPosition(gg_unit_hsor_0272)
    call RemoveGuardPosition(gg_unit_nws1_0204)
    call RemoveGuardPosition(gg_unit_nws1_0203)
    call RemoveGuardPosition(gg_unit_hsor_0169)
    call RemoveGuardPosition(gg_unit_hsor_0248)
    call RemoveGuardPosition(gg_unit_nws1_0206)
    call RemoveGuardPosition(gg_unit_nws1_0205)
    call RemoveGuardPosition(gg_unit_hsor_0271)
    call RemoveGuardPosition(gg_unit_hmpr_0274)
    // Brown on middle island
    call RemoveGuardPosition(gg_unit_hmpr_0012)
    call RemoveGuardPosition(gg_unit_hsor_0067)
    call RemoveGuardPosition(gg_unit_nws1_0277)
    call RemoveGuardPosition(gg_unit_nhea_0245)
    call RemoveGuardPosition(gg_unit_hhes_0219)
    call RemoveGuardPosition(gg_unit_nhea_0242)
    call RemoveGuardPosition(gg_unit_hhes_0123)
    call RemoveGuardPosition(gg_unit_nws1_0278)
    call RemoveGuardPosition(gg_unit_nhea_0241)
    call RemoveGuardPosition(gg_unit_hmpr_0075)
    call RemoveGuardPosition(gg_unit_nhea_0077)
    // Init Funky No Pathing Towers
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersA), function Trig_Initialization_Func165002)
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersB), function Trig_Initialization_Func166002)
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersA)), GetRectCenter(gg_rct_PATH_Guard_Tower01A))
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersA)), GetRectCenter(gg_rct_PATH_Guard_Tower02A))
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersA)), GetRectCenter(gg_rct_PATH_Guard_Tower03A))
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersB)), GetRectCenter(gg_rct_PATH_Guard_Tower01B))
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersB)), GetRectCenter(gg_rct_PATH_Guard_Tower02B))
    call SetUnitPositionLoc(GroupPickRandomUnit(GetUnitsInRectAll(gg_rct_PATH_Guard_TowersB)), GetRectCenter(gg_rct_PATH_Guard_Tower03B))
    // Init Map Settings
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    call SetTerrainFogExBJ(0, 2500.00, 11000.00, 0, 0.00, 50.00, 30.00)
    call SetTimeOfDay(20.00)
    // Init Quests
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_068", "TRIGSTR_069", "ReplaceableTextures\\CommandButtons\\BTN3M3.tga")
    set udg_QuestKey=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QuestKey, "TRIGSTR_070")
    set udg_QuestKeyRequirementAltars=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QuestKey, "TRIGSTR_071")
    set udg_QuestKeyRequirementPieces=GetLastCreatedQuestItemBJ()
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_119", "TRIGSTR_120", "ReplaceableTextures\\CommandButtons\\BTNCOP.tga")
    set udg_QuestGate=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QuestGate, "TRIGSTR_121")
    set udg_QuestGateRequirementArthas=GetLastCreatedQuestItemBJ()
    // Init Triggers
    call RemoveGuardPosition(gg_unit_nhea_0266)
    call RemoveGuardPosition(gg_unit_nhea_0264)
    call RemoveGuardPosition(gg_unit_nhea_0265)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Handicap
//===========================================================================
function Trig_Handicap_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Handicap_Actions takes nothing returns nothing
    call SetPlayerHandicapBJ(udg_P_HighElves01, bj_HANDICAP_EASY)
    call SetPlayerHandicapBJ(udg_P_HighElves02, bj_HANDICAP_EASY)
    call SetPlayerHandicapBJ(udg_P_HighElves03, bj_HANDICAP_EASY)
    call SetPlayerHandicapBJ(udg_P_HighElves04, bj_HANDICAP_EASY)
    call SetPlayerHandicapBJ(Player(8), bj_HANDICAP_EASY)
    call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_HANDICAP_EASY)
endfunction

//===========================================================================
function InitTrig_Handicap takes nothing returns nothing
    set gg_trg_Handicap=CreateTrigger()
    call TriggerAddCondition(gg_trg_Handicap, Condition(function Trig_Handicap_Conditions))
    call TriggerAddAction(gg_trg_Handicap, function Trig_Handicap_Actions)
endfunction

//===========================================================================
// Trigger: Difficulty Not Hard
//===========================================================================
function Trig_Difficulty_Not_Hard_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() != MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Difficulty_Not_Hard_Actions takes nothing returns nothing
    call RemoveGuardPosition(gg_unit_hhes_0170)
    call RemoveUnit(gg_unit_hhes_0170)
    call RemoveGuardPosition(gg_unit_nws1_0135)
    call RemoveUnit(gg_unit_nws1_0135)
    call RemoveGuardPosition(gg_unit_nheb_0026)
    call RemoveUnit(gg_unit_nheb_0026)
    call RemoveGuardPosition(gg_unit_nheb_0030)
    call RemoveUnit(gg_unit_nheb_0030)
endfunction

//===========================================================================
function InitTrig_Difficulty_Not_Hard takes nothing returns nothing
    set gg_trg_Difficulty_Not_Hard=CreateTrigger()
    call TriggerAddCondition(gg_trg_Difficulty_Not_Hard, Condition(function Trig_Difficulty_Not_Hard_Conditions))
    call TriggerAddAction(gg_trg_Difficulty_Not_Hard, function Trig_Difficulty_Not_Hard_Actions)
endfunction

