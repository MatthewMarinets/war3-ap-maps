//===========================================================================
function Trig_Rescue_Zeppelins_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_AAAP_Undead ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rescue_Zeppelins_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Rescue_Zeppelins_Queue, true)
endfunction

//===========================================================================
function InitTrig_Rescue_Zeppelins takes nothing returns nothing
    set gg_trg_Rescue_Zeppelins=CreateTrigger()
    call TriggerRegisterUnitInRangeSimple(gg_trg_Rescue_Zeppelins, 512.00, gg_unit_ngad_0047)
    call TriggerAddCondition(gg_trg_Rescue_Zeppelins, Condition(function Trig_Rescue_Zeppelins_Conditions))
    call TriggerAddAction(gg_trg_Rescue_Zeppelins, function Trig_Rescue_Zeppelins_Actions)
endfunction

//===========================================================================
// Trigger: Rescue Zeppelins Queue
//===========================================================================
function Trig_Rescue_Zeppelins_Queue_Conditions takes nothing returns boolean
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rescue_Zeppelins_Queue_Actions takes nothing returns nothing
    call RescueUnitBJ(udg_Zeppelin01, udg_AAAP_Undead, true)
    call RescueUnitBJ(udg_Zeppelin02, udg_AAAP_Undead, true)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_HINT, "TRIGSTR_447")
    call status_check_location(24)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_GoblinLaboratory), 5.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_GoblinLaboratory))
    call PlaySoundBJ(gg_snd_GoblinZeppelinReady1)
    call UnitShareVisionBJ(true, udg_GoblinLaboratory, udg_AAAP_Undead)
    call UnitShareVisionBJ(false, udg_GoblinLaboratory, udg_AAAP_Undead)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_HINT, "TRIGSTR_448")
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_RevealLandingSpot), 5.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_RevealLandingSpot))
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_RevealLandingSpot), 512)
    set udg_VisibilityLandingSpot=GetLastCreatedFogModifier()
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Rescue_Zeppelins_Queue takes nothing returns nothing
    set gg_trg_Rescue_Zeppelins_Queue=CreateTrigger()
    call TriggerAddCondition(gg_trg_Rescue_Zeppelins_Queue, Condition(function Trig_Rescue_Zeppelins_Queue_Conditions))
    call TriggerAddAction(gg_trg_Rescue_Zeppelins_Queue, function Trig_Rescue_Zeppelins_Queue_Actions)
endfunction

