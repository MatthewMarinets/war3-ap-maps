//===========================================================================
// Trigger: Insufficient Keys
//===========================================================================
function Trig_Insufficient_Keys_Conditions takes nothing returns boolean
    if ( not GetBooleanAnd(( GetEnteringUnit() == udg_Arthas ), ( udg_NumberOfPiecesFound <= 2 )) ) then
        return false
    endif
    if ( not GetBooleanOr(( udg_Key01Acquired == true ), GetBooleanOr(( udg_Key02Acquired == true ), ( udg_Key03Acquired == true ))) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Insufficient_Keys_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PanCameraToTimedLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Gate_Region), 1.00)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Gate_Region), 4.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Gate_Region))
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_436", gg_snd_U04AArthas16, "TRIGSTR_437", bj_TIMETYPE_ADD, 0, true)
    call TransmissionFromUnitTypeWithNameBJ(udg_AAAPG_Undead, udg_AAAP_Undead, 'uktg', "TRIGSTR_438", GetRectCenter(gg_rct_Gate_Region), gg_snd_U04AKelThuzad17, "TRIGSTR_439", bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
endfunction

//===========================================================================
function InitTrig_Insufficient_Keys takes nothing returns nothing
    set gg_trg_Insufficient_Keys=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Insufficient_Keys, gg_rct_Gate_Region)
    call TriggerAddCondition(gg_trg_Insufficient_Keys, Condition(function Trig_Insufficient_Keys_Conditions))
    call TriggerAddAction(gg_trg_Insufficient_Keys, function Trig_Insufficient_Keys_Actions)
endfunction

//===========================================================================
// Trigger: No Keys Hint
//===========================================================================
function Trig_No_Keys_Hint_Conditions takes nothing returns boolean
    if ( not GetBooleanAnd(( GetEnteringUnit() == udg_Arthas ), ( udg_NumberOfPiecesFound <= 2 )) ) then
        return false
    endif
    if ( not GetBooleanAnd(( udg_Key01Acquired == false ), GetBooleanAnd(( udg_Key02Acquired == false ), ( udg_Key03Acquired == false ))) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_No_Keys_Hint_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PanCameraToTimedLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Gate_Region), 1.00)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Gate_Region), 4.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Gate_Region))
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_526")
endfunction

//===========================================================================
function InitTrig_No_Keys_Hint takes nothing returns nothing
    set gg_trg_No_Keys_Hint=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_No_Keys_Hint, gg_rct_Gate_Region)
    call TriggerAddCondition(gg_trg_No_Keys_Hint, Condition(function Trig_No_Keys_Hint_Conditions))
    call TriggerAddAction(gg_trg_No_Keys_Hint, function Trig_No_Keys_Hint_Actions)
endfunction

//===========================================================================
// Trigger: Trigger Victory
//===========================================================================
function Trig_Trigger_Victory_Conditions takes nothing returns boolean
    if ( not GetBooleanAnd(( GetEnteringUnit() == udg_Arthas ), ( udg_NumberOfPiecesFound == 3 )) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Trigger_Victory_Func006002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Trigger_Victory_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Insufficient_Keys)
    call DisableTrigger(gg_trg_Defeat)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop01)
    set udg_VictoryInProgress=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Trigger_Victory_Func006002)
    call SuspendHeroXPBJ(false, udg_Arthas)
    call PlaySoundBJ(gg_snd_QuestCompleted)
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_COP)
    call SetUnitManaPercentBJ(udg_Sylvanas, 0.00)
    call ConditionalTriggerExecute(gg_trg_Victory_Cinematic)
endfunction

//===========================================================================
function InitTrig_Trigger_Victory takes nothing returns nothing
    set gg_trg_Trigger_Victory=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Trigger_Victory, gg_rct_Gate_Region)
    call TriggerAddCondition(gg_trg_Trigger_Victory, Condition(function Trig_Trigger_Victory_Conditions))
    call TriggerAddAction(gg_trg_Trigger_Victory, function Trig_Trigger_Victory_Actions)
endfunction

