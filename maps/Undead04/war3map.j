//===========================================================================
// Trigger: SpiderEntance
//===========================================================================
function Trig_SpiderEntance_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'ucry', udg_P_Reinforcements, GetRectCenter(gg_rct_InitialFiendA01), 135.00)
    set udg_InitialFiendA=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'ucry', udg_P_Reinforcements, GetRectCenter(gg_rct_InitialFiendB01), 135.00)
    set udg_InitialFiendB=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'ucry', udg_P_Reinforcements, GetRectCenter(gg_rct_InitialFiendC01), 135.00)
    set udg_InitialFiendC=GetLastCreatedUnit()
    call IssuePointOrderLocBJ(udg_InitialFiendA, "move", GetRectCenter(gg_rct_InitialFiendA02))
    call IssuePointOrderLocBJ(udg_InitialFiendB, "move", GetRectCenter(gg_rct_InitialFiendB02))
    call IssuePointOrderLocBJ(udg_InitialFiendC, "move", GetRectCenter(gg_rct_InitialFiendC02))
endfunction

