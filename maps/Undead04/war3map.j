    call CameraSetupSetField(gg_cam_Intro10, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro10, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro10, CAMERA_FIELD_FARZ, 4545.5, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Intro10, - 4760.9, - 1905.6, 0.0)

    set gg_cam_Intro11=CreateCameraSetup()
