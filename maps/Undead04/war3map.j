function Trig_Intro_Cinematic_Actions takes nothing returns nothing
    call UseTimeOfDayBJ(false)
    call SetStackedSoundBJ(true, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop01)
    call SetTerrainFogExBJ(0, 900.00, 4500.00, 0, 0.00, 40.00, 60.00)
    call VolumeGroupResetBJ()
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // Banging On The Gate
    call CameraSetupApplyForPlayer(true, gg_cam_Intro00, udg_AAAP_Undead, 0)
    call IssueTargetDestructableOrder(udg_Arthas, "attack", udg_ElfGate01)
    call TriggerSleepAction(1.00)
    // NOW SKIPPABLE
    call EnableTrigger(gg_trg_IntroCancel)
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func013001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_InitialRepairer01, "move", GetRectCenter(gg_rct_Repair01))
    call IssuePointOrderLocBJ(udg_InitialRepairer02, "move", GetRectCenter(gg_rct_Repair02))
    call TriggerSleepAction(2.00)
    if ( Trig_Intro_Cinematic_Func017001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_AAAP_Undead, 0)
    call TriggerSleepAction(2.00)
    if ( Trig_Intro_Cinematic_Func020001() ) then
        return
    else
        call DoNothing()
    endif
    call KillDestructable(udg_ElfGate01)
    call SetUnitInvulnerable(udg_InitialRepairer01, false)
    call SetUnitInvulnerable(udg_InitialRepairer02, false)
    call TriggerSleepAction(0.10)
    if ( Trig_Intro_Cinematic_Func025001() ) then
        return
    else
        call DoNothing()
    endif
    call ResetUnitAnimation(udg_InitialRepairer01)
    call ExplodeUnitBJ(udg_InitialRepairer02)
    call SetUnitLifeBJ(udg_InitialRepairer01, 150.00)
    call SetPlayerAllianceStateBJ(udg_P_HighElves01, udg_AAAP_Undead, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_AAAP_Undead, udg_P_HighElves01, bj_ALLIANCE_UNALLIED)
    call TriggerSleepAction(0.20)
    if ( Trig_Intro_Cinematic_Func032001() ) then
        return
    else
        call DoNothing()
    endif
    call IssueTargetOrderBJ(udg_Arthas, "attack", udg_InitialRepairer01)
    call IssuePointOrderLocBJ(udg_InitialArcher01, "move", GetUnitLoc(udg_Arthas))
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func036001() ) then
        return
    else
        call DoNothing()
    endif
    call IssueTargetOrderBJ(udg_Arthas, "attack", udg_InitialArcher01)
    call IssueTargetOrderBJ(udg_InitialArcher01, "attack", udg_Arthas)
    call TriggerSleepAction(2.00)
    if ( Trig_Intro_Cinematic_Func040001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func043001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Arthas, "attack", GetRectCenter(gg_rct_Arthas02))
    call IssuePointOrderLocBJ(udg_InitialGhoulA, "attack", GetRectCenter(gg_rct_InitialGhoulA02))
    call IssuePointOrderLocBJ(udg_InitialGhoulB, "attack", GetRectCenter(gg_rct_InitialGhoulB02))
    call IssuePointOrderLocBJ(udg_InitialGhoulC, "attack", GetRectCenter(gg_rct_InitialGhoulC02))
    call IssuePointOrderLocBJ(udg_InitialGhoulD, "attack", GetRectCenter(gg_rct_InitialGhoulD02))
    call IssuePointOrderLocBJ(udg_InitialNecromancerA, "attack", GetRectCenter(gg_rct_InitialNecroA02))
    call IssuePointOrderLocBJ(udg_InitialNecromancerB, "attack", GetRectCenter(gg_rct_InitialNecroB02))
    // Through the Gate
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02, udg_AAAP_Undead, 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func054001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro03, udg_AAAP_Undead, 6.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(6.00)
    if ( Trig_Intro_Cinematic_Func058001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func061001() ) then
        return
    else
        call DoNothing()
    endif
    // Undead Advancing
    call CameraSetupApplyForPlayer(true, gg_cam_Intro04, udg_AAAP_Undead, 0.00)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func065001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro05, udg_AAAP_Undead, 4.00)
    call TriggerSleepAction(4.00)
    if ( Trig_Intro_Cinematic_Func069001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call IssuePointOrderLocBJ(udg_FleeingElf01, "move", GetRandomLocInRect(gg_rct_FleeingElfDestination))
    call IssuePointOrderLocBJ(udg_FleeingElf02, "move", GetRandomLocInRect(gg_rct_FleeingElfDestination))
    call IssuePointOrderLocBJ(udg_FleeingElf03, "move", GetRandomLocInRect(gg_rct_FleeingElfDestination))
    call TriggerSleepAction(1.20)
    if ( Trig_Intro_Cinematic_Func075001() ) then
        return
    else
        call DoNothing()
    endif
    // Bridge Scene
    call CameraSetupApplyForPlayer(true, gg_cam_Intro06, udg_AAAP_Undead, 0.00)
    call SetUnitInvulnerable(udg_Arthas, true)
    call IssueImmediateOrderBJ(udg_InitialGhoulA, "stop")
    call IssueImmediateOrderBJ(udg_InitialGhoulB, "stop")
    call IssueImmediateOrderBJ(udg_InitialGhoulC, "stop")
    call IssueImmediateOrderBJ(udg_InitialGhoulD, "stop")
    call IssueImmediateOrderBJ(udg_InitialNecromancerA, "stop")
    call IssueImmediateOrderBJ(udg_InitialNecromancerB, "stop")
    call IssueImmediateOrderBJ(udg_Arthas, "stop")
    call SetUnitPositionLoc(udg_InitialGhoulA, GetRectCenter(gg_rct_InitialGhoulA01))
    call SetUnitPositionLoc(udg_InitialGhoulB, GetRectCenter(gg_rct_InitialGhoulB01))
    call SetUnitPositionLoc(udg_InitialGhoulC, GetRectCenter(gg_rct_InitialGhoulC01))
    call SetUnitPositionLoc(udg_InitialGhoulD, GetRectCenter(gg_rct_InitialGhoulD01))
    call SetUnitPositionLoc(udg_InitialNecromancerA, GetRectCenter(gg_rct_InitialNecroA01))
    call SetUnitPositionLoc(udg_InitialNecromancerB, GetRectCenter(gg_rct_InitialNecroB01))
    call SetUnitPositionLoc(udg_Arthas, GetRectCenter(gg_rct_Arthas01))
    call SetUnitFacingToFaceLocTimed(udg_InitialGhoulA, GetRectCenter(gg_rct_InitialGhoulA02), 0)
    call SetUnitFacingToFaceLocTimed(udg_InitialGhoulB, GetRectCenter(gg_rct_InitialGhoulB02), 0)
    call SetUnitFacingToFaceLocTimed(udg_InitialGhoulC, GetRectCenter(gg_rct_InitialGhoulC02), 0)
    call SetUnitFacingToFaceLocTimed(udg_InitialGhoulD, GetRectCenter(gg_rct_InitialGhoulD02), 0)
    call SetUnitFacingToFaceLocTimed(udg_InitialNecromancerA, GetRectCenter(gg_rct_InitialNecroA02), 0)
    call SetUnitFacingToFaceLocTimed(udg_InitialNecromancerB, GetRectCenter(gg_rct_InitialNecroB02), 0)
    call SetUnitFacingToFaceLocTimed(udg_Arthas, GetRectCenter(gg_rct_Arthas02), 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func101001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro07, udg_AAAP_Undead, 6.00)
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_Arthas02))
    call IssuePointOrderLocBJ(udg_InitialGhoulA, "move", GetRectCenter(gg_rct_InitialGhoulA02))
    call IssuePointOrderLocBJ(udg_InitialGhoulB, "move", GetRectCenter(gg_rct_InitialGhoulB02))
    call IssuePointOrderLocBJ(udg_InitialGhoulC, "move", GetRectCenter(gg_rct_InitialGhoulC02))
    call IssuePointOrderLocBJ(udg_InitialGhoulD, "move", GetRectCenter(gg_rct_InitialGhoulD02))
    call IssuePointOrderLocBJ(udg_InitialNecromancerA, "move", GetRectCenter(gg_rct_InitialNecroA02))
    call IssuePointOrderLocBJ(udg_InitialNecromancerB, "move", GetRectCenter(gg_rct_InitialNecroB02))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.50)
    if ( Trig_Intro_Cinematic_Func112001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_Sylvanas01))
    call SetUnitInvulnerable(udg_FleeingElf02, false)
    call SetUnitLifeBJ(udg_FleeingElf02, 20.00)
    call IssueTargetOrderBJ(udg_Arthas, "deathcoil", udg_FleeingElf02)
    call TriggerSleepAction(3.00)
    if ( Trig_Intro_Cinematic_Func118001() ) then
        return
    else
        call DoNothing()
    endif
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Sylvanas, "TRIGSTR_115", gg_snd_U04ASylvanas03, "TRIGSTR_116", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Intro_Cinematic_Func120001() ) then
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func122001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func125001() ) then
        return
    else
        call DoNothing()
    endif
    // Bridge Scene
    call CameraSetupApplyForPlayer(true, gg_cam_Intro08, udg_AAAP_Undead, 0)
    set udg_SpawnedStartingTroops=true
    call CreateNUnitsAtLoc(1, 'umtw', udg_AAAP_Undead, GetRectCenter(gg_rct_Meatwagon01), 135.00)
    call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte01), 135.00)
    call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte02), 135.00)
    call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte03), 135.00)
    call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte04), 135.00)
    call SetUnitFacingToFaceUnitTimed(udg_Sylvanas, udg_Arthas, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call SetCineModeVolumeGroupsBJ()
    call TriggerSleepAction(0.25)
    if ( Trig_Intro_Cinematic_Func138001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro09, udg_AAAP_Undead, 12.00)
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func141001() ) then
        return
    else
        call DoNothing()
    endif
    call WaitForSoundBJ(gg_snd_U04ASylvanas03, 1.00)
    if ( Trig_Intro_Cinematic_Func143001() ) then
        return
    else
        call DoNothing()
    endif
    call PlayThematicMusicBJ("Sound\\Music\\mp3Music\\DarkAgents.mp3")
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Sylvanas, "TRIGSTR_039", gg_snd_U04ASylvanas01, "TRIGSTR_040", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Intro_Cinematic_Func146001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_Sylvanas02))
    call TriggerSleepAction(0.50)
    if ( Trig_Intro_Cinematic_Func149001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro10, udg_AAAP_Undead, 0)
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_045", gg_snd_U04AArthas04, "TRIGSTR_046", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Intro_Cinematic_Func152001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro11, udg_AAAP_Undead, 0)
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Sylvanas, "TRIGSTR_063", gg_snd_U04ASylvanas05, "TRIGSTR_064", bj_TIMETYPE_SUB, 1.00, true)
    if ( Trig_Intro_Cinematic_Func155001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro12, udg_AAAP_Undead, 0)
    call SetUnitAnimation(udg_Sylvanas, "stand victory")
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func159001() ) then
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectTargetUnitBJ("origin", udg_Sylvanas, "Abilities\\Spells\\nightelf\\starfall\\starfallcaster.mdl")
    set udg_StarfallFX=GetLastCreatedEffectBJ()
    call AttachSoundToUnitBJ(gg_snd_StarfallCaster1, udg_Sylvanas)
    call PlaySoundBJ(gg_snd_StarfallCaster1)
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func165001() ) then
        return
    else
        call DoNothing()
    endif
    call KillDestructable(udg_Bridge01)
    call PlaySoundBJ(udg_BridgeSound01)
    call TriggerSleepAction(0.25)
    if ( Trig_Intro_Cinematic_Func169001() ) then
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(udg_BridgeSound02)
    call TriggerSleepAction(2.75)
    if ( Trig_Intro_Cinematic_Func172001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro08, udg_AAAP_Undead, 0)
    call ResetTerrainFogBJ()
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_065", gg_snd_U04AArthas06, "TRIGSTR_066", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Intro_Cinematic_Func176001() ) then
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_StarfallFX)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_Func180001() ) then
        return
    else
        call DoNothing()
    endif
    // NO LONGER SKIPPABLE
    call DisableTrigger(gg_trg_IntroCancel)
    // End Cinematic
    call ResetToGameCameraForPlayer(udg_AAAP_Undead, 0.00)
    call PanCameraToTimedLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Arthas01), 0.00)
    call SetSkyModel(null)
    // Set Unit Facing
    call SetUnitFacingTimed(udg_InitialGhoulA, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulB, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulC, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulD, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialNecromancerA, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialNecromancerB, 135.00, 0)
    // Visibility Settings
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal01), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal02), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal03), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CinematicModeBJ(false, udg_AAAPG_Undead)
    call UseTimeOfDayBJ(true)
    call RemoveUnit(udg_FleeingElf01)
    call RemoveUnit(udg_FleeingElf02)
    call RemoveUnit(udg_FleeingElf03)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves01), function Trig_Intro_Cinematic_Func206002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves02), function Trig_Intro_Cinematic_Func207002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves03), function Trig_Intro_Cinematic_Func208002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_AAAP_Undead), function Trig_Intro_Cinematic_Func209002)
    call SuspendHeroXPBJ(true, udg_Arthas)
    call ConditionalTriggerExecute(gg_trg_SylvanasReturnsHome)
    call SetUnitManaPercentBJ(udg_Arthas, 100)
    call SelectUnitSingle(udg_Arthas)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_SpiderEntance)
    call TriggerSleepAction(2.00)
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_135")
    call TriggerSleepAction(0.50)
    // Reveal Visibility Regions
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar01), 512)
    set udg_Altar01Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar01Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar01), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar01))
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar02), 512)
    set udg_Altar02Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar02Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar02), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar02))
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar03), 512)
    set udg_Altar03Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar03Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar03), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar03))
    call ConditionalTriggerExecute(gg_trg_Start_AI)
endfunction

