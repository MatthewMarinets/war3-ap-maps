    set gg_trg___Reveal_Gate_Quest=CreateTrigger()
    call TriggerAddCondition(gg_trg___Reveal_Gate_Quest, Condition(function Trig___Reveal_Gate_Quest_Conditions))
    call TriggerAddAction(gg_trg___Reveal_Gate_Quest, function Trig___Reveal_Gate_Quest_Actions)
endfunction

