function Trig_Victory_Cinematic_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Fade Out and Establish Setting
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call UseTimeOfDayBJ(false)
    // Save Game Data
    call RemoveItem(udg_Key3Part)
    call EnableTrigger(gg_trg_Victory_Cancel)
    // Start Cinematic
    call CameraSetupApplyForPlayer(true, gg_cam_End00A, udg_AAAP_Undead, 0)
    call CinematicModeBJ(true, udg_AAAPG_Undead)
    call status_check_location(0)
    call SetSkyModel("Environment\\Sky\\DalaranSky\\DalaranSky.mdl")
    call SetTerrainFogExBJ(0, 900.00, 4500.00, 0, 0.00, 40.00, 60.00)
    if ( Trig_Victory_Cinematic_Func016001() ) then
        call ReviveHeroLoc(udg_Arthas, GetRectCenter(gg_rct_Gate_Region), false)
    else
        call SetUnitPositionLoc(udg_Sylvanas, GetRectCenter(gg_rct_EndSylvanas01))
    endif
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Victory_Cinematic_Func017002)
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Victory_Cinematic_Func018002)
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Victory_Cinematic_Func019002)
    call SetUnitInvulnerable(udg_Arthas, true)
    call RemoveGuardPosition(udg_Sylvanas)
    call SetUnitPositionLoc(udg_Sylvanas, GetRectCenter(gg_rct_EndSylvanas01))
    call ShowUnitShow(udg_Sylvanas)
    call CreateNUnitsAtLocFacingLocBJ(1, 'UC00', udg_AAAP_Undead, GetRectCenter(gg_rct_Gate_Region), GetUnitLoc(udg_Sylvanas))
    set udg_CinematicArthas=GetLastCreatedUnit()
    call SetUnitInvulnerable(udg_CinematicArthas, true)
    call SetUnitAnimation(udg_CinematicArthas, "stand ready")
    call SetUnitFacingToFaceUnitTimed(udg_Sylvanas, udg_CinematicArthas, 0)
    call SetUnitPathing(udg_CinematicArthas, false)
    call PlayThematicMusicBJ("Sound\\Music\\mp3Music\\DarkVictory.mp3")
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // NOW SKIPPABLE
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func034001() ) then
        return
    else
        call DoNothing()
    endif
    // Arthas Powers Up
    call CameraSetupApplyForPlayer(true, gg_cam_End00B, udg_AAAP_Undead, 10.00)
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func038001() ) then
        return
    else
        call DoNothing()
    endif
    call VolumeGroupResetBJ()
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_CinematicArthas, "TRIGSTR_034", gg_snd_EvilArthasYes1, "TRIGSTR_035", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Victory_Cinematic_Func041001() ) then
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func043001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_CinematicArthas, "spell - 1")
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func046001() ) then
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectTargetUnitBJ("origin", udg_CinematicArthas, "Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl")
    call AddSpecialEffectTargetUnitBJ("origin", udg_CinematicArthas, "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    set udg_SpecialEffect01=GetLastCreatedEffectBJ()
    call AttachSoundToUnitBJ(gg_snd_DeathPactTargetBirth1, udg_CinematicArthas)
    call PlaySoundBJ(gg_snd_DeathPactTargetBirth1)
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func053001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_CinematicArthas, "stand ready")
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func056001() ) then
        return
    else
        call DoNothing()
    endif
    // Camera Pulls Out
    call CameraSetupApplyForPlayer(true, gg_cam_End01A, udg_AAAP_Undead, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_End01B, udg_AAAP_Undead, 8.00)
    call TriggerSleepAction(1.00)
    if ( Trig_Victory_Cinematic_Func061001() ) then
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    // Arthas Attacks Gate
    call SetDestructableInvulnerableBJ(udg_ElfGate02, false)
    call ResetUnitAnimation(udg_CinematicArthas)
    call IssueTargetDestructableOrder(udg_CinematicArthas, "attack", udg_ElfGate02)
    call TriggerSleepAction(1.00)
    if ( Trig_Victory_Cinematic_Func069001() ) then
        return
    else
        call DoNothing()
    endif
    // Gate Is Destroyed
    call SetSoundPositionLocBJ(gg_snd_BuildingDeathLargeHuman, GetDestructableLoc(udg_ElfGate02), 0)
    call PlaySoundBJ(gg_snd_BuildingDeathLargeHuman)
    call KillDestructable(udg_ElfGate02)
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func075001() ) then
        return
    else
        call DoNothing()
    endif
    // Arthas Talks and Enters the Gate
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_CinematicArthas, "TRIGSTR_031", gg_snd_U04AArthas18, "TRIGSTR_032", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Victory_Cinematic_Func079001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitPathing(udg_CinematicArthas, false)
    call IssuePointOrderLocBJ(udg_CinematicArthas, "move", GetRectCenter(gg_rct_EndArthas01))
    call AttachSoundToUnitBJ(gg_snd_HorseLoop2, udg_CinematicArthas)
    call PlaySoundBJ(gg_snd_HorseLoop2)
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func085001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_Victory_Cinematic_Func088001() ) then
        return
    else
        call DoNothing()
    endif
    // Fade Out and Shift Camera
    call CameraSetupApplyForPlayer(true, gg_cam_End02A, udg_AAAP_Undead, 0.00)
    call RemoveUnit(udg_CinematicArthas)
    set udg_CinematicArthas=null
    call ShowUnitShow(udg_Arthas)
    call SetUnitPositionLocFacingLocBJ(udg_Arthas, GetRectCenter(gg_rct_EndArthas02), GetUnitLoc(udg_Sylvanas))
    call SetUnitInvulnerable(udg_Arthas, true)
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_EndArthas03))
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_EndSylvanas02))
    // Fade In and Arthas Moves Forward
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Victory_Cinematic_Func101001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_End02B, udg_AAAP_Undead, 5.00)
    call TriggerSleepAction(2.00)
    if ( Trig_Victory_Cinematic_Func104001() ) then
        return
    else
        call DoNothing()
    endif
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop01)
    call CameraSetupApplyForPlayer(true, gg_cam_EndSylvanas, udg_AAAP_Undead, 0.00)
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Sylvanas, "TRIGSTR_059", gg_snd_U04ASylvanas12, "TRIGSTR_060", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Victory_Cinematic_Func108001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitPathing(udg_Sylvanas, false)
    call RemoveGuardPosition(udg_Sylvanas)
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_EndSylvanas01))
    call TriggerSleepAction(1.00)
    if ( Trig_Victory_Cinematic_Func113001() ) then
        return
    else
        call DoNothing()
    endif
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_457", gg_snd_U04AArthas11, "TRIGSTR_458", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Victory_Cinematic_Func115001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_End05, udg_AAAP_Undead, 0.00)
    // NO LONGER SKIPPABLE
    call DisableTrigger(gg_trg_Victory_Cancel)
    call TriggerSleepAction(1.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Run)
endfunction

//===========================================================================
function InitTrig_Victory_Cinematic takes nothing returns nothing
    set gg_trg_Victory_Cinematic=CreateTrigger()
    call TriggerAddCondition(gg_trg_Victory_Cinematic, Condition(function Trig_Victory_Cinematic_Conditions))
    call TriggerAddAction(gg_trg_Victory_Cinematic, function Trig_Victory_Cinematic_Actions)
endfunction

//===========================================================================
// Trigger: Victory Cancel
//===========================================================================
function Trig_Victory_Cancel_Func006001 takes nothing returns boolean
    return ( udg_CinematicArthas != null )
endfunction

function Trig_Victory_Cancel_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_VictoryCancelled=true
    call StopSoundBJ(GetLastPlayedSound(), true)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_Victory_Cancel_Func006001() ) then
        call RemoveUnit(udg_CinematicArthas)
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Next_Level_Run)
endfunction

