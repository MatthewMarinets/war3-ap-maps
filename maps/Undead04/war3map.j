//===========================================================================
function Trig_IntroCancel_Conditions takes nothing returns boolean
    if ( not ( udg_IntroCancelled == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCancel_Func020001 takes nothing returns boolean
    return ( udg_SpawnedStartingTroops == false )
endfunction

function Trig_IntroCancel_Func021001 takes nothing returns boolean
    return ( udg_SpawnedStartingTroops == false )
endfunction

function Trig_IntroCancel_Func022001 takes nothing returns boolean
    return ( udg_SpawnedStartingTroops == false )
endfunction

function Trig_IntroCancel_Func023001 takes nothing returns boolean
    return ( udg_SpawnedStartingTroops == false )
endfunction

function Trig_IntroCancel_Func024001 takes nothing returns boolean
    return ( udg_SpawnedStartingTroops == false )
endfunction

function Trig_IntroCancel_Func026002 takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "stop")
endfunction

function Trig_IntroCancel_Func027002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_IntroCancel_Func028002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_IntroCancel_Func029002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_IntroCancel_Func030002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_IntroCancel_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_IntroCancelled=true
    // Move Units Into Position
    call DestroyEffectBJ(udg_StarfallFX)
    call SetUnitPositionLoc(udg_InitialGhoulA, GetRectCenter(gg_rct_InitialGhoulA02))
    call SetUnitPositionLoc(udg_InitialGhoulB, GetRectCenter(gg_rct_InitialGhoulB02))
    call SetUnitPositionLoc(udg_InitialGhoulC, GetRectCenter(gg_rct_InitialGhoulC02))
    call SetUnitPositionLoc(udg_InitialGhoulD, GetRectCenter(gg_rct_InitialGhoulD02))
    call SetUnitPositionLoc(udg_InitialNecromancerA, GetRectCenter(gg_rct_InitialNecroA02))
    call SetUnitPositionLoc(udg_InitialNecromancerB, GetRectCenter(gg_rct_InitialNecroB02))
    call SetUnitPositionLoc(udg_Arthas, GetRectCenter(gg_rct_Arthas02))
    call SetUnitFacingTimed(udg_Arthas, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulA, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulB, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulC, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialGhoulD, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialNecromancerA, 135.00, 0)
    call SetUnitFacingTimed(udg_InitialNecromancerB, 135.00, 0)
    if ( Trig_IntroCancel_Func020001() ) then
        call CreateNUnitsAtLoc(1, 'umtw', udg_AAAP_Undead, GetRectCenter(gg_rct_Meatwagon01), 135.00)
    else
        call DoNothing()
    endif
    if ( Trig_IntroCancel_Func021001() ) then
        call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte01), 135.00)
    else
        call DoNothing()
    endif
    if ( Trig_IntroCancel_Func022001() ) then
        call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte02), 135.00)
    else
        call DoNothing()
    endif
    if ( Trig_IntroCancel_Func023001() ) then
        call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte03), 135.00)
    else
        call DoNothing()
    endif
    if ( Trig_IntroCancel_Func024001() ) then
        call CreateNUnitsAtLoc(1, 'uaco', udg_AAAP_Undead, GetRectCenter(gg_rct_Acolyte04), 135.00)
    else
        call DoNothing()
    endif
    call SetUnitPositionLoc(udg_Sylvanas, GetRectCenter(gg_rct_Sylvanas02))
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_IntroCancel_Func026002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves01), function Trig_IntroCancel_Func027002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves02), function Trig_IntroCancel_Func028002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_P_HighElves03), function Trig_IntroCancel_Func029002)
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_AAAP_Undead), function Trig_IntroCancel_Func030002)
    call RemoveUnit(gg_unit_hpea_0158)
    call RemoveUnit(gg_unit_hpea_0162)
    call RemoveUnit(gg_unit_nhea_0264)
    call RemoveUnit(gg_unit_nhea_0265)
    call RemoveUnit(gg_unit_nhea_0266)
    call RemoveUnit(gg_unit_hpea_0149)
    call RemoveUnit(udg_FleeingElf01)
    call RemoveUnit(udg_FleeingElf02)
    call RemoveUnit(udg_FleeingElf03)
    call ConditionalTriggerExecute(gg_trg_SylvanasReturnsHome)
    // Kill Gate and Bridge
    call KillDestructable(udg_ElfGate01)
    call KillDestructable(udg_Bridge01)
    // Reset Camera and Environmental Settings
    call StopSoundBJ(GetLastPlayedSound(), true)
    call ResetToGameCameraForPlayer(udg_AAAP_Undead, 0.00)
    call PanCameraToTimedLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Arthas01), 0.00)
    call SetTerrainFogExBJ(0, 1500.00, 12000.00, 0, 100, 60.00, 20.00)
    call CinematicModeBJ(false, udg_AAAPG_Undead)
    call UseTimeOfDayBJ(true)
    call SetSkyModel(null)
    call SuspendHeroXPBJ(true, udg_Arthas)
    // Visibility Settings
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_BridgeCollapse), 768.00)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal01), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal02), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Reveal03), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call SetUnitManaPercentBJ(udg_Arthas, 100)
    call SelectUnitSingle(udg_Arthas)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // Go Go Power Crypt Fiends Intro
    call ConditionalTriggerExecute(gg_trg_SpiderEntance)
    call TriggerSleepAction(2.00)
    // Quest Settings
    call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_157")
    call TriggerSleepAction(0.50)
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar01), 512)
    set udg_Altar01Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar01Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar01), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar01))
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar02), 512)
    set udg_Altar02Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar02Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar02), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar02))
    call CreateFogModifierRadiusLocBJ(true, udg_AAAP_Undead, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Altar03), 512)
    set udg_Altar03Visibility=GetLastCreatedFogModifier()
    call FogModifierStop(udg_Altar03Visibility)
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar03), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar03))
    call ConditionalTriggerExecute(gg_trg_Start_AI)
endfunction

