endfunction

function Trig_Key01_Acquired_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_NumberOfPiecesFound=( udg_NumberOfPiecesFound + 1 )
    set udg_Key01Acquired=true
    call TriggerSleepAction(0.01)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key02_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key03_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key02_and_Key03_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key01_and_Key2Part_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key02_and_Key2Part_Acquired)
    call ConditionalTriggerExecute(gg_trg___Key03_and_Key2Part_Acquired)
    call TriggerSleepAction(2)
    call SetSpeechVolumeGroupsBJ()
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar01))
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar01), 1.00)
    if ( Trig_Key01_Acquired_Func015001() ) then
        call TransmissionFromUnitTypeWithNameBJ(udg_AAAPG_Undead, udg_AAAP_Undead, 'uktg', "TRIGSTR_081", GetRectCenter(gg_rct_Altar01), gg_snd_U04AKelThuzad10, "TRIGSTR_082", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func016001() ) then
        call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_092", gg_snd_U04AArthas13, "TRIGSTR_093", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func017001() ) then
        call TransmissionFromUnitTypeWithNameBJ(udg_AAAPG_Undead, udg_AAAP_Undead, 'uktg', "TRIGSTR_455", GetRectCenter(gg_rct_Altar01), gg_snd_U04AKelThuzad15, "TRIGSTR_456", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    call VolumeGroupResetBJ()
    if ( Trig_Key01_Acquired_Func019001() ) then
        call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar02), 7.00)
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func020001() ) then
        call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar02))
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func021001() ) then
        call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_Altar03), 7.00)
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func022001() ) then
        call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_Altar03))
    else
        call DoNothing()
    endif
    call TriggerSleepAction(2.00)
    if ( Trig_Key01_Acquired_Func024001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_530")
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func025001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_535")
    else
        call DoNothing()
    endif
    if ( Trig_Key01_Acquired_Func026001() ) then
        call QuestMessageBJ(udg_AAAPG_Undead, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_540")
    else
        call DoNothing()
    endif
    call DestroyFogModifier(udg_Altar01Visibility)
    call ConditionalTriggerExecute(gg_trg___Reveal_Gate_Quest)
endfunction

