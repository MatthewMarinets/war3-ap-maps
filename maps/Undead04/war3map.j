//===========================================================================
// Trigger: RevealSecret01
//===========================================================================
function Trig_RevealSecret01_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_AAAP_Undead ) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RevealSecret01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call UnitShareVisionBJ(true, gg_unit_hhes_0021, udg_AAAP_Undead)
    call UnitShareVisionBJ(true, gg_unit_hhes_0037, udg_AAAP_Undead)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetRectCenter(gg_rct_SpawnGolem01))
    call PingMinimapLocForForce(udg_AAAPG_Undead, GetRectCenter(gg_rct_SpawnGolem01), 1.00)
    call SetSoundPositionLocBJ(udg_SecretSound, GetRectCenter(gg_rct_Secret01), 0)
    call PlaySoundBJ(udg_SecretSound)
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_RevealSecret01A)
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_RevealSecret01B)
endfunction

//===========================================================================
function InitTrig_RevealSecret01 takes nothing returns nothing
    set gg_trg_RevealSecret01=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_RevealSecret01, gg_rct_RevealSecret01A)
    call TriggerRegisterEnterRectSimple(gg_trg_RevealSecret01, gg_rct_RevealSecret01B)
    call TriggerAddCondition(gg_trg_RevealSecret01, Condition(function Trig_RevealSecret01_Conditions))
    call TriggerAddAction(gg_trg_RevealSecret01, function Trig_RevealSecret01_Actions)
endfunction

