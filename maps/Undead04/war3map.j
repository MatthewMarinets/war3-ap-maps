    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_ROTATION, 223.1, 0.0)
    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_ANGLE_OF_ATTACK, 326.5, 0.0)
    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_TARGET_DISTANCE, 1127.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro11, CAMERA_FIELD_FARZ, 4545.5, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Intro11, - 4760.9, - 1905.6, 0.0)

    set gg_cam_Intro12=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Intro12, CAMERA_FIELD_ZOFFSET, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Intro12, CAMERA_FIELD_ROTATION, 271.6, 0.0)
    call CameraSetupSetField(gg_cam_Intro12, CAMERA_FIELD_ANGLE_OF_ATTACK, 323.5, 0.0)
    call CameraSetupSetField(gg_cam_Intro12, CAMERA_FIELD_TARGET_DISTANCE, 1996.5, 0.0)
    call CameraSetupSetField(gg_cam_Intro12, CAMERA_FIELD_ROLL, 0.0, 0.0)
