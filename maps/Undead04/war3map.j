//===========================================================================
// Trigger: Dragon Hawk Hint Queue
//===========================================================================
function Trig_Dragon_Hawk_Hint_Queue_Conditions takes nothing returns boolean
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Hawk_Hint_Queue_Func008002 takes nothing returns nothing
    call UnitAddIndicatorBJ(GetEnumUnit(), 100, 100, 100, 0)
endfunction

function Trig_Dragon_Hawk_Hint_Queue_Actions takes nothing returns nothing
    call PingMinimapLocForForce(GetPlayersAll(), GetUnitLoc(gg_unit_nws1_0286), 5.00)
    call SetCameraQuickPositionLocForPlayer(udg_AAAP_Undead, GetUnitLoc(gg_unit_nws1_0286))
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), udg_AAAP_Undead, 'unec', "TRIGSTR_517", GetUnitLoc(gg_unit_unec_0257), gg_snd_U04BNecromancer08, "TRIGSTR_518", bj_TIMETYPE_ADD, 0, true)
    call TransmissionFromUnitWithNameBJ(udg_AAAPG_Undead, udg_Arthas, "TRIGSTR_515", gg_snd_U04BArthas09, "TRIGSTR_516", bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_AAAP_Undead, 'ucry'), function Trig_Dragon_Hawk_Hint_Queue_Func008002)
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Dragon_Hawk_Hint_Queue takes nothing returns nothing
    set gg_trg_Dragon_Hawk_Hint_Queue=CreateTrigger()
    call TriggerAddCondition(gg_trg_Dragon_Hawk_Hint_Queue, Condition(function Trig_Dragon_Hawk_Hint_Queue_Conditions))
    call TriggerAddAction(gg_trg_Dragon_Hawk_Hint_Queue, function Trig_Dragon_Hawk_Hint_Queue_Actions)
endfunction

//===========================================================================
// Trigger: Kill Altar01
//===========================================================================
function Trig_Kill_Altar01_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Altar01 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kill_Altar01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.20)
    call CreateItemLoc('I025', GetRectCenter(gg_rct_Altar01))
    set udg_Key01=GetLastCreatedItem()
    set udg_Altar01Destroyed=true
    call SetItemInvulnerableBJ(udg_Key01, true)
    call SetItemDroppableBJ(udg_Key01, false)
    call ConditionalTriggerExecute(gg_trg_All_Altars_have_been_destroyed)
    call ConditionalTriggerExecute(gg_trg_Mooncrystal01Hint)
endfunction

