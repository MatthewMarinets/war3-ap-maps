//===========================================================================
function Trig_All_Altars_have_been_destroyed_Conditions takes nothing returns boolean
    if ( not ( udg_Altar01Destroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Altar02Destroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Altar03Destroyed == true ) ) then
        return false
    endif
    if ( not ( udg_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

