//===========================================================================
function Trig_Begin_Attack_Waves_Conditions takes nothing returns boolean
    if ( not ( udg_AIAttacking == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'ugol' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Begin_Attack_Waves_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Begin_Attack_Waves_Timer_Safety)
endfunction

