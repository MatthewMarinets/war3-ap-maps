    return ( udg_ElfgateCancel == true )
endfunction

function Trig_Elfgate_Cinematic_Func107001 takes nothing returns boolean
    return ( udg_ElfgateCancel == true )
endfunction

function Trig_Elfgate_Cinematic_Actions takes nothing returns nothing
    call SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    call SetUnitInvulnerable(udg_Arthas, true)
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Arthas)
    call ClearSelection()
    call UseTimeOfDayBJ(false)
    // ---------
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop01)
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop02)
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop03)
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop04)
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop05)
    call SetStackedSoundBJ(false, gg_snd_WaterLakeLoop1, gg_rct_LakeLoop06)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop01)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop02)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop03)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop04)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop05)
    call SetStackedSoundBJ(false, gg_snd_WaterStreamLoop1, gg_rct_StreamLoop06)
    // ---------
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_183")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call CinematicModeBJ(true, GetPlayersAll())
    call status_check_location(0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.50)
    // Music Theme
    call PlayThematicMusicBJ("Sound\\Music\\mp3Music\\DarkAgents.mp3")
    call KillDestructable(gg_dest_LTe4_0021)
    // HIDING
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(1)), function Trig_Elfgate_Cinematic_Func031002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(2)), function Trig_Elfgate_Cinematic_Func032002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(3)), function Trig_Elfgate_Cinematic_Func033002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(4)), function Trig_Elfgate_Cinematic_Func034002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(5)), function Trig_Elfgate_Cinematic_Func035002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(10)), function Trig_Elfgate_Cinematic_Func036002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Elfgate_Cinematic_Func037002)
    // ----------
    call SetPlayerAllianceStateBJ(Player(1), Player(3), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), Player(3), bj_ALLIANCE_ALLIED_VISION)
    // ----------
    call SetPlayerAllianceStateBJ(Player(3), Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(3), Player(1), bj_ALLIANCE_ALLIED_VISION)
    // ----------
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(3)), function Trig_Elfgate_Cinematic_Func045002)
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(1)), function Trig_Elfgate_Cinematic_Func046002)
    // NOW SKIPPABLE
    call EnableTrigger(gg_trg_Elfgate_Cinematic_Cancel)
    // -----Sylvanas-----
    if ( Trig_Elfgate_Cinematic_Func050001() ) then
        call ReviveHeroLoc(udg_Sylvanas, GetRectCenter(gg_rct_03Sylvanas_A), false)
    else
        call SetUnitPositionLocFacingBJ(udg_Sylvanas, GetRectCenter(gg_rct_03Sylvanas_A), 190.00)
    endif
    call ShowUnitShow(udg_Sylvanas)
    call RemoveGuardPosition(udg_Sylvanas)
    call CreateNUnitsAtLoc(1, 'nhea', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_01_A), 45.00)
    set udg_RetreatUnit01=GetLastCreatedUnit()
    call RemoveGuardPosition(GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'hhes', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_02_A), 45.00)
    set udg_RetreatUnit02=GetLastCreatedUnit()
    call RemoveGuardPosition(GetLastCreatedUnit())
    // -----Arthas-----
    if ( Trig_Elfgate_Cinematic_Func060001() ) then
        call ReviveHeroLoc(udg_Arthas, GetRectCenter(gg_rct_Arthas_Ending_A), false)
    else
        call SetUnitPositionLocFacingBJ(udg_Arthas, GetRectCenter(gg_rct_Arthas_Ending_A), 80.00)
    endif
    call SetUnitFacingTimed(udg_Arthas, 80.00, 0.00)
    call ShowUnitShow(udg_Arthas)
    // PAUSING
    call PauseAllUnitsBJ(true)
    call PauseUnitBJ(false, udg_Arthas)
    // -----Camera-----
    call CameraSetupApplyForPlayer(true, gg_cam_Elfgate_03, Player(3), 0.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PauseUnitBJ(false, udg_Sylvanas)
    call TriggerSleepAction(0.20)
    if ( Trig_Elfgate_Cinematic_Func071001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_03Sylvanas_B))
    call TriggerSleepAction(3.00)
    if ( Trig_Elfgate_Cinematic_Func074001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Sylvanas, 270.00, 0.30)
    call CameraSetupApplyForPlayer(true, gg_cam_Elfgate_04, Player(3), 8.00)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Sylvanas, "TRIGSTR_029", gg_snd_U03BSylvanas18, "TRIGSTR_051", bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(3.50)
    if ( Trig_Elfgate_Cinematic_Func079001() ) then
        return
    else
        call DoNothing()
    endif
    call PauseUnitBJ(false, udg_RetreatUnit01)
    call PauseUnitBJ(false, udg_RetreatUnit02)
    call IssuePointOrderLocBJ(udg_RetreatUnit01, "move", GetRectCenter(gg_rct_Elfgate_Reinforcement_01_B))
    call IssuePointOrderLocBJ(udg_RetreatUnit02, "move", GetRectCenter(gg_rct_Elfgate_Reinforcement_02_B))
    call TriggerSleepAction(1.00)
    if ( Trig_Elfgate_Cinematic_Func085001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Sylvanas, "move", GetRectCenter(gg_rct_03Sylvanas_C))
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_Arthas_Ending_A_Copy))
    call WaitForSoundBJ(gg_snd_U03BSylvanas18, 0)
    if ( Trig_Elfgate_Cinematic_Func089001() ) then
        return
    else
        call DoNothing()
    endif
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_064", gg_snd_U03BArthas19, "TRIGSTR_065", bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(2)
    if ( Trig_Elfgate_Cinematic_Func092001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Arthas, "Spell - 1")
    call TriggerSleepAction(1.00)
    if ( Trig_Elfgate_Cinematic_Func095001() ) then
        return
    else
        call DoNothing()
    endif
    call CreateNUnitsAtLoc(1, 'ugho', Player(3), GetRectCenter(gg_rct_Elfgate_Reinforcement_01_A), 45.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_Elfgate_Reinforcement_01_B))
    call CreateNUnitsAtLoc(1, 'ugho', Player(3), GetRectCenter(gg_rct_Elfgate_Reinforcement_01_A), 45.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_Elfgate_Reinforcement_01_B))
    call TriggerSleepAction(1.00)
    if ( Trig_Elfgate_Cinematic_Func101001() ) then
        return
    else
        call DoNothing()
    endif
    call WaitForSoundBJ(gg_snd_U03BArthas19, 0)
    if ( Trig_Elfgate_Cinematic_Func103001() ) then
        return
    else
        call DoNothing()
    endif
    call DisableTrigger(gg_trg_Elfgate_Cinematic_Cancel)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    if ( Trig_Elfgate_Cinematic_Func107001() ) then
        return
    else
        call DoNothing()
    endif
    // -----Start Next Mission-----
    call TriggerExecute(gg_trg_Victory)
endfunction

