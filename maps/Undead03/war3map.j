endfunction

function Trig_Region_Follow_Arthas_Actions takes nothing returns nothing
    call MoveRectToLoc(gg_rct_Arthas_Region_Follow, GetUnitLoc(udg_Arthas))
    call ForGroupBJ(udg_SylvanasAttackGroup, function Trig_Region_Follow_Arthas_Func002002)
    if ( Trig_Region_Follow_Arthas_Func003001() ) then
        return
    else
        call DoNothing()
    endif
    call MoveRectToLoc(gg_rct_Arthas_Region_Follow, GetUnitLoc(GroupPickRandomUnit(GetUnitsOfPlayerMatching(Player(3), Condition(function Trig_Region_Follow_Arthas_Func004002001001002)))))
    call ForGroupBJ(udg_SylvanasAttackGroup, function Trig_Region_Follow_Arthas_Func005002)
endfunction

