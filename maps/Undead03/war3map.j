//===========================================================================
// Trigger: Discover the Gate
//===========================================================================
function Trig_Discover_the_Gate_Conditions takes nothing returns boolean
    if ( not ( udg_GAMEOVER == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Discover_the_Gate_Func006001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Arthas) == true )
endfunction

function Trig_Discover_the_Gate_Func007001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Sylvanas) == true )
endfunction

function Trig_Discover_the_Gate_Actions takes nothing returns nothing
    call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_01Elfgate_Vis), 800.00)
    set udg_ElfGateVis=GetLastCreatedFogModifier()
    call DestroyFogModifier(udg_ElfGateVis)
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_Discover_the_Gate_Func006001() ) then
        call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_199", gg_snd_U03BArthas16, "TRIGSTR_200", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Discover_the_Gate_Func007001() ) then
        call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Sylvanas, "TRIGSTR_219", gg_snd_U03BSylvanas17, "TRIGSTR_220", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    call VolumeGroupResetBJ()
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_01Elfgate_Vis), 4.00)
    call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_01Elfgate_Vis))
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // -----Guard Entrance-----
    call CreateNUnitsAtLoc(1, 'hhes', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_01_A), 10.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_Elfgate_Discovered_01))
    call TriggerSleepAction(0.50)
    call CreateNUnitsAtLoc(1, 'hhes', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_01_A), 10.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_Elfgate_Discovered_01))
    call TriggerSleepAction(0.50)
    call CreateNUnitsAtLoc(1, 'nhea', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_02_A), 10.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_Elfgate_Discovered_01))
    call TriggerSleepAction(0.50)
    call CreateNUnitsAtLoc(1, 'nhea', Player(1), GetRectCenter(gg_rct_Elfgate_Reinforcement_02_A), 10.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_Elfgate_Discovered_01))
endfunction

