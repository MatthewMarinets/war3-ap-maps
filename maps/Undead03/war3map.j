function Trig_Orange_Reveal_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Orange_Blacken)
    call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Orange_Town_Vis), 650.00)
    set udg_OrangeReveal=GetLastCreatedFogModifier()
    call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_06_Gnoll_Camp_01_Vis), 400.00)
    set udg_GnollCampVis01=GetLastCreatedFogModifier()
    call DestroyFogModifier(udg_GnollCampVis01)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Orange_Town_Vis), 4.00)
    call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Orange_Town_Vis))
    // ----------
    if ( Trig_Orange_Reveal_Func012001() ) then
        call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Purple_Vis), 650.00)
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func013001() ) then
        call DestroyFogModifier(GetLastCreatedFogModifier())
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func014001() ) then
        call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Purple_Vis), 4.00)
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func015001() ) then
        call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Purple_Vis))
    else
        call DoNothing()
    endif
    // -
    if ( Trig_Orange_Reveal_Func017001() ) then
        call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Pink_Vis), 650.00)
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func018001() ) then
        call DestroyFogModifier(GetLastCreatedFogModifier())
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func019001() ) then
        call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Pink_Vis), 4.00)
    else
        call DoNothing()
    endif
    if ( Trig_Orange_Reveal_Func020001() ) then
        call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Pink_Vis))
    else
        call DoNothing()
    endif
    // ----------
    call QueuedTriggerAddBJ(gg_trg_HINT, true)
endfunction

