        return false
    endif
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(Player(1), Condition(function Trig_Night_Elf_Base_Destroyed_Func007001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

