function InitTrig_Intro_Cancel takes nothing returns nothing
    set gg_trg_Intro_Cancel=CreateTrigger()
    call DisableTrigger(gg_trg_Intro_Cancel)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cancel, Player(3))
    call TriggerAddAction(gg_trg_Intro_Cancel, function Trig_Intro_Cancel_Actions)
endfunction

//===========================================================================
// Trigger: Cinematic Dialogue A
//
// Arthas outside Quel'Thalas
//===========================================================================
function Trig_Cinematic_Dialogue_A_Func020001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func024001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func029001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func032001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func036001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func048001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func050001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func055001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Func059001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_A_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    call SetTerrainFogExBJ(0, 800.00, 6000.00, 0.00, 20.00, 40.00, 55.00)
    call SetUnitPositionLoc(udg_Arthas, GetRectCenter(gg_rct_01Arthas_A_Start))
    call SetUnitFacingTimed(udg_Arthas, 290.00, 0.00)
    // ----------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CinematicModeBJ(true, GetPlayersAll())
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_01, Player(3), 0.00)
    // Music Theme
    call ClearMapMusicBJ()
    call TriggerSleepAction(0.01)
    call SetMapMusicIndexedBJ("music", 0)
    call PlayThematicMusicBJ("Sound\\Music\\mp3Music\\SadMystery.mp3")
    // -----------
    // NOW SKIPPABLE
    call EnableTrigger(gg_trg_Intro_Cancel)
    call TriggerSleepAction(1.00)
    if ( Trig_Cinematic_Dialogue_A_Func020001() ) then
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_01, Player(3), 0.00)
    call SetUnitFacingTimed(udg_Arthas, 310.00, 0.40)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_022", gg_snd_U03AArthas01, "TRIGSTR_023", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_A_Func024001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_01, Player(3), 0.00)
    call SetUnitFacingTimed(udg_Arthas, 200.00, 0.50)
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), Player(3), 'uktg', "TRIGSTR_027", GetRectCenter(GetPlayableMapRect()), gg_snd_U03AKelThuzad02, "TRIGSTR_031", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_A_Func029001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_032", gg_snd_U03AArthas03, "TRIGSTR_033", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_A_Func032001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Arthas, 290.00, 0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( Trig_Cinematic_Dialogue_A_Func036001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitPositionLoc(udg_Arthas, GetRectCenter(gg_rct_01Arthas_A))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call SetTerrainFogExBJ(0, 800.00, 4200.00, 0.00, 20.00, 40.00, 55.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_02, Player(3), 0.00)
    call SetCameraTargetControllerNoZForPlayer(Player(3), udg_Arthas, 0, 0, false)
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_01Arthas_B))
    call AttachSoundToUnitBJ(gg_snd_HorseLoop3, udg_Arthas)
    call PlaySoundBJ(gg_snd_HorseLoop3)
    call IssuePointOrderLocBJ(udg_Ghoul04, "move", GetRectCenter(gg_rct_01Escort_02_A))
    call IssuePointOrderLocBJ(udg_Ghoul03, "move", GetRectCenter(gg_rct_01Escort_01_A))
    call TriggerSleepAction(1.50)
    if ( Trig_Cinematic_Dialogue_A_Func048001() ) then
        return
    else
        call DoNothing()
    endif
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), Player(3), 'uktg', "TRIGSTR_034", GetRectCenter(GetPlayableMapRect()), gg_snd_U03AKelThuzad04, "TRIGSTR_035", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_A_Func050001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Necromancer01, "move", GetRectCenter(gg_rct_01Necromancer_01_A))
    // ----------
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_03, Player(3), 0.00)
    call TriggerSleepAction(1.00)
    if ( Trig_Cinematic_Dialogue_A_Func055001() ) then
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Necromancer01, bj_UNIT_FACING, 80.00)
    call SetUnitFacingTimed(udg_Arthas, bj_UNIT_FACING, 310.00)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_037", gg_snd_U03AArthas05, "TRIGSTR_036", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_A_Func059001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_03, Player(3), 0.00)
    call IssuePointOrderLocBJ(udg_Necromancer01, "move", GetRectCenter(gg_rct_01Escort_03_A))
    call CreateNUnitsAtLoc(1, 'nemi', Player(2), GetRectCenter(gg_rct_01Priest_01_A), 0.00)
    set udg_Prisoner=GetLastCreatedUnit()
    call RemoveGuardPosition(GetLastCreatedUnit())
    call RemoveUnit(gg_unit_uktg_0081)
    call ConditionalTriggerExecute(gg_trg_Cinematic_Dialogue_B)
endfunction

