function InitTrig_Combat_Start takes nothing returns nothing
    set gg_trg_Combat_Start=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Combat_Start, Player(1), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Combat_Start, Player(2), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Combat_Start, Player(4), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Combat_Start, Player(5), EVENT_PLAYER_UNIT_ATTACKED)
