function Trig_Region_Follow_Arthas_Func003001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Arthas) == true )
endfunction

function Trig_Region_Follow_Arthas_Func004002001001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
