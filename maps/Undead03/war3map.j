    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_D_Func043001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_D_Actions takes nothing returns nothing
    // -----Ghouls-----
    call SetUnitPositionLoc(udg_Ghoul01, GetRectCenter(gg_rct_01Ghoul_01_B))
    call SetUnitFacingTimed(udg_Ghoul01, 0.00, 0)
    call SetUnitPositionLoc(udg_Ghoul02, GetRectCenter(gg_rct_01Ghoul_02_B))
    call SetUnitFacingTimed(udg_Ghoul02, 0.00, 0)
    call SetUnitPositionLoc(udg_Ghoul03, GetRectCenter(gg_rct_01Ghoul_03_B))
    call SetUnitFacingTimed(udg_Ghoul03, 0.00, 0)
    call SetUnitPositionLoc(udg_Ghoul04, GetRectCenter(gg_rct_01Ghoul_04_B))
    call SetUnitFacingTimed(udg_Ghoul04, 0.00, 0)
    call SetUnitPositionLoc(udg_Ghoul05, GetRectCenter(gg_rct_01Ghoul_05_B))
    call SetUnitFacingTimed(udg_Ghoul05, 0.00, 0)
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_01Arthas_D))
    call RemoveUnit(udg_Prisoner)
    // ----------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.40, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PlayThematicMusicBJ("Sound\\Music\\mp3Music\\DarkAgents.mp3")
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_05, Player(3), 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_06, Player(3), 5.00)
    // -----Meat Wagon-----
    call IssuePointOrderLocBJ(udg_MeatWagon01, "move", GetRectCenter(gg_rct_01Meat_Wagon_01_A))
    call AttachSoundToUnitBJ(gg_snd_MeatWagonYes1, udg_MeatWagon01)
    call SetSoundVolumeBJ(gg_snd_MeatWagonYes1, 70.00)
    call PlaySoundBJ(gg_snd_MeatWagonYes1)
    call TriggerSleepAction(1.20)
    if ( Trig_Cinematic_Dialogue_D_Func026001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call IssuePointOrderLocBJ(udg_MeatWagon02, "move", GetRectCenter(gg_rct_01Meat_Wagon_02_A))
    call AttachSoundToUnitBJ(gg_snd_MeatWagonYes2, udg_MeatWagon02)
    call SetSoundVolumeBJ(gg_snd_MeatWagonYes2, 70.00)
    call PlaySoundBJ(gg_snd_MeatWagonYes2)
    call TriggerSleepAction(1.20)
    if ( Trig_Cinematic_Dialogue_D_Func033001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call IssuePointOrderLocBJ(udg_MeatWagon03, "move", GetRectCenter(gg_rct_01Meat_Wagon_03_A))
    call AttachSoundToUnitBJ(gg_snd_MeatWagonYes3, udg_MeatWagon03)
    call SetSoundVolumeBJ(gg_snd_MeatWagonYes3, 70.00)
    call PlaySoundBJ(gg_snd_MeatWagonYes3)
    call TriggerSleepAction(1.20)
    if ( Trig_Cinematic_Dialogue_D_Func040001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.40, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.40)
    if ( Trig_Cinematic_Dialogue_D_Func043001() ) then
        return
    else
        call DoNothing()
    endif
    // -----Acolyte-----
    call SetUnitPositionLoc(udg_Necromancer01, GetRectCenter(gg_rct_01Necromancer_01_B))
    call SetUnitPositionLoc(udg_Necromancer02, GetRectCenter(gg_rct_01Necromancer_02_A))
    call SetUnitPositionLoc(udg_Acolyte01, GetRectCenter(gg_rct_01Acolyte_01_B))
    call SetUnitPositionLoc(udg_Acolyte02, GetRectCenter(gg_rct_01Acolyte_02_B))
    call SetUnitPositionLoc(udg_Acolyte03, GetRectCenter(gg_rct_01Acolyte_03_B))
    call SetUnitPositionLoc(udg_Acolyte04, GetRectCenter(gg_rct_01Acolyte_04_B))
    call SetUnitPositionLoc(udg_Acolyte05, GetRectCenter(gg_rct_01Acolyte_05_B))
    // ----------
    call SetUnitPositionLocFacingBJ(udg_MeatWagon01, GetRectCenter(gg_rct_01Meat_Wagon_01_B), 305.00)
    call SetUnitPositionLocFacingBJ(udg_MeatWagon02, GetRectCenter(gg_rct_01Meat_Wagon_02_B), 305.00)
    call SetUnitPositionLocFacingBJ(udg_MeatWagon03, GetRectCenter(gg_rct_01Meat_Wagon_03_B), 305.00)
    call ConditionalTriggerExecute(gg_trg_Cinematic_Dialogue_E)
endfunction

