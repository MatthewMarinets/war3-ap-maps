//===========================================================================
// Trigger: Discover Orange 01
//===========================================================================
function Trig_Discover_Orange_01_Conditions takes nothing returns boolean
    if ( not ( udg_GAMEOVER == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Discover_Orange_01_Actions takes nothing returns nothing
    // ----------
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), gg_unit_nhef_0094, "TRIGSTR_142", gg_snd_U03BHighElfVillager31, "TRIGSTR_143", bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // ----------
    call IssuePointOrderLocBJ(gg_unit_nhef_0094, "move", GetRectCenter(gg_rct_Orange_Elf_Hide_01))
    call IssuePointOrderLocBJ(gg_unit_nhem_0135, "move", GetRectCenter(gg_rct_Orange_Elf_Hide_01))
    call IssuePointOrderLocBJ(gg_unit_nhem_0134, "move", GetRectCenter(gg_rct_Orange_Elf_Hide_01))
    call IssuePointOrderLocBJ(gg_unit_nhef_0099, "move", GetRectCenter(gg_rct_Orange_Elf_Hide_01))
    // ---------
