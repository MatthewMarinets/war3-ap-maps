endfunction

function Trig_Elfgate_Cinematic_Func046002 takes nothing returns nothing
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, GetEnumUnit())
endfunction

function Trig_Elfgate_Cinematic_Func050001 takes nothing returns boolean
    return ( IsUnitDeadBJ(udg_Sylvanas) == true )
endfunction

function Trig_Elfgate_Cinematic_Func060001 takes nothing returns boolean
    return ( IsUnitDeadBJ(udg_Arthas) == true )
endfunction

function Trig_Elfgate_Cinematic_Func071001 takes nothing returns boolean
