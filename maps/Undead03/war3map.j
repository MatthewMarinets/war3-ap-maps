function Trig_Cinematic_Dialogue_E_Actions takes nothing returns nothing
    call TriggerSleepAction(0.30)
    if ( Trig_Cinematic_Dialogue_E_Func002001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.40, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_07, Player(3), 0.00)
    call VolumeGroupResetBJ()
    call TriggerSleepAction(0.30)
    if ( Trig_Cinematic_Dialogue_E_Func007001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call IssueTargetDestructableOrder(udg_MeatWagon01, "attack", gg_dest_LTlt_0209)
    call IssueTargetDestructableOrder(udg_MeatWagon02, "attack", gg_dest_LTlt_0203)
    call IssueTargetDestructableOrder(udg_MeatWagon03, "attack", gg_dest_LTlt_0213)
