//===========================================================================
// Trigger: Intro Cancel
//===========================================================================
function Trig_Intro_Cancel_Func029002 takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_Intro_Cancel_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_IntroCancel=true
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.40, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.60)
    call CinematicModeBJ(false, GetPlayersAll())
    call ResetToGameCameraForPlayer(Player(3), 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Skipped, Player(3), 0.00)
    call SetSkyModel(null)
    call SetTerrainFogExBJ(0, 800.00, 3000.00, 0.00, 20.00, 40.00, 55.00)
    // ----Move Units-----
    call SetUnitPositionLocFacingBJ(udg_Acolyte01, GetRectCenter(gg_rct_02Acolyte_01_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Acolyte02, GetRectCenter(gg_rct_02Acolyte_02_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Acolyte03, GetRectCenter(gg_rct_02Acolyte_03_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Acolyte04, GetRectCenter(gg_rct_02Acolyte_04_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Acolyte05, GetRectCenter(gg_rct_02Acolyte_05_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Ghoul01, GetRectCenter(gg_rct_02Ghoul_01_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Ghoul02, GetRectCenter(gg_rct_02Ghoul_02_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Ghoul03, GetRectCenter(gg_rct_02Ghoul_03_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Ghoul04, GetRectCenter(gg_rct_02Ghoul_04_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Ghoul05, GetRectCenter(gg_rct_02Ghoul_05_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_MeatWagon01, GetRectCenter(gg_rct_02Meat_Wagon_01_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_MeatWagon02, GetRectCenter(gg_rct_02Meat_Wagon_02_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_MeatWagon03, GetRectCenter(gg_rct_02Meat_Wagon_03_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Necromancer01, GetRectCenter(gg_rct_02Necromancer_01_C), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Necromancer02, GetRectCenter(gg_rct_02Necromancer_02_B), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Arthas, GetRectCenter(gg_rct_01Arthas_E), 0.00)
    call RemoveUnit(gg_unit_uktg_0081)
    call EnumDestructablesInRectAll(gg_rct_Kill_Trees_Starting_Town, function Trig_Intro_Cancel_Func029002)
    // ----------
    call SelectUnitSingle(udg_Arthas)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // -----Start Mission-----
    call IssuePointOrderLocBJ(gg_unit_nhem_0068, "move", GetRectCenter(gg_rct_Orange_Discovered))
    call ConditionalTriggerExecute(gg_trg_High_Elf_Retreat)
    call ConditionalTriggerExecute(gg_trg_Mission_Start)
endfunction

