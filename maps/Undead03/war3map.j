//===========================================================================
// Trigger: Cinematic Dialogue F
//
// This trigger is fired when player comes into view of High Elf Village after the opening cinematic is either played or cancelled.
//===========================================================================
function Trig_Cinematic_Dialogue_F_Conditions takes nothing returns boolean
    if ( not ( udg_IntroCancel == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Dialogue_F_Func011001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_F_Func013001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_F_Func017001 takes nothing returns boolean
    return ( udg_IntroCancel == true )
endfunction

function Trig_Cinematic_Dialogue_F_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetTerrainFogExBJ(0, 1000.00, 4200.00, 0.00, 20.00, 40.00, 55.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_08, Player(3), 0.00)
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), Player(3), 'uktg', "TRIGSTR_081", GetUnitLoc(udg_Arthas), gg_snd_U03AKelThuzad09, "TRIGSTR_082", bj_TIMETYPE_ADD, 0, true)
    call SetSoundVolumeBJ(gg_snd_WaterStreamLoop1, 100.00)
    call SetSoundVolumeBJ(gg_snd_WaterWaterFallLoop1, 100.00)
    call SetStackedSoundBJ(false, gg_snd_WaterWaterFallLoop1, gg_rct_StreamLoop05)
    call AttachSoundToUnitBJ(gg_snd_GhoulWhat1, udg_Ghoul05)
    call SetSoundVolumeBJ(gg_snd_GhoulWhat1, 70.00)
    call PlaySoundBJ(gg_snd_GhoulWhat1)
    if ( Trig_Cinematic_Dialogue_F_Func011001() ) then
        return
    else
        call DoNothing()
    endif
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), Player(3), 'Uear', "TRIGSTR_087", GetUnitLoc(udg_Arthas), gg_snd_U03AArthas10, "TRIGSTR_088", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_F_Func013001() ) then
        return
    else
        call DoNothing()
    endif
    call SetTerrainFogExBJ(0, 1500.00, 3000.00, 0.00, 20.00, 40.00, 55.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_09, Player(3), 0.00)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), gg_unit_nhea_0003, "TRIGSTR_090", gg_snd_U03AElfArcher11, "TRIGSTR_091", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_F_Func017001() ) then
        return
    else
        call DoNothing()
    endif
    // NO LONGER SKIPPABLE
    call DisableTrigger(gg_trg_Intro_Cancel)
    call IssuePointOrderLocBJ(gg_unit_nhem_0068, "move", GetRectCenter(gg_rct_Orange_Discovered))
    call ConditionalTriggerExecute(gg_trg_High_Elf_Retreat)
    // -----Resume Game Play-----
    call CinematicModeBJ(false, GetPlayersAll())
    call ResetToGameCameraForPlayer(Player(3), 1.50)
    // -----Mission Start-----
    call ConditionalTriggerExecute(gg_trg_Mission_Start)
endfunction

//===========================================================================
