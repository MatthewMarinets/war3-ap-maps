    call SetSoundVolumeBJ(gg_snd_GhoulWarcry1, 70.00)
    call PlaySoundBJ(gg_snd_GhoulWarcry1)
    call IssuePointOrderLocBJ(udg_Ghoul02, "move", GetRectCenter(gg_rct_02Ghoul_02_C))
    call IssuePointOrderLocBJ(udg_Ghoul03, "move", GetRectCenter(gg_rct_02Ghoul_03_C))
    call IssuePointOrderLocBJ(udg_Ghoul04, "move", GetRectCenter(gg_rct_02Ghoul_04_C))
    call IssuePointOrderLocBJ(udg_Ghoul05, "move", GetRectCenter(gg_rct_02Ghoul_05_C))
    // ----------
    call TriggerSleepAction(0.50)
    if ( Trig_Cinematic_Dialogue_E_Func029001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Arthas, "move", GetRectCenter(gg_rct_01Arthas_E))
    call IssuePointOrderLocBJ(udg_Necromancer01, "move", GetRectCenter(gg_rct_02Necromancer_01_C))
    call IssuePointOrderLocBJ(udg_Necromancer02, "move", GetRectCenter(gg_rct_02Necromancer_02_B))
    // ----------
    call TriggerSleepAction(0.50)
    if ( Trig_Cinematic_Dialogue_E_Func035001() ) then
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_MeatWagon01, "move", GetRectCenter(gg_rct_02Meat_Wagon_01_C))
    call IssuePointOrderLocBJ(udg_MeatWagon02, "move", GetRectCenter(gg_rct_02Meat_Wagon_02_C))
    call IssuePointOrderLocBJ(udg_MeatWagon03, "move", GetRectCenter(gg_rct_02Meat_Wagon_03_C))
    // ----------
    call IssuePointOrderLocBJ(udg_Acolyte01, "move", GetRectCenter(gg_rct_02Acolyte_01_C))
    call IssuePointOrderLocBJ(udg_Acolyte02, "move", GetRectCenter(gg_rct_02Acolyte_02_C))
    call IssuePointOrderLocBJ(udg_Acolyte03, "move", GetRectCenter(gg_rct_02Acolyte_03_C))
    call IssuePointOrderLocBJ(udg_Acolyte04, "move", GetRectCenter(gg_rct_02Acolyte_04_C))
    call IssuePointOrderLocBJ(udg_Acolyte05, "move", GetRectCenter(gg_rct_02Acolyte_05_C))
    call ConditionalTriggerExecute(gg_trg_Cinematic_Dialogue_F)
endfunction

