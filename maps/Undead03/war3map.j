    // ----------
    call SelectHeroSkill(udg_Sylvanas, 'AHca')
    call SelectHeroSkill(udg_Sylvanas, 'AEar')
    call SelectHeroSkill(udg_Sylvanas, 'AHca')
    call SelectHeroSkill(udg_Sylvanas, 'AEar')
    // ----------
    call GroupAddUnitSimple(udg_Sylvanas, udg_SylvanasAttackGroup)
    call GroupAddUnitSimple(gg_unit_hhes_0093, udg_SylvanasAttackGroup)
    call GroupAddUnitSimple(gg_unit_hhes_0157, udg_SylvanasAttackGroup)
endfunction

