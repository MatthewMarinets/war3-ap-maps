function Trig_Setup_Undead_Actions takes nothing returns nothing
    call SetPlayerStateBJ(Player(3), PLAYER_STATE_RESOURCE_GOLD, 1500)
    call SetPlayerStateBJ(Player(3), PLAYER_STATE_RESOURCE_LUMBER, 550)
    call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_01Escort_03_A), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    // -----High Elf Villagers-----
    call SetPlayerAllianceBJ(Player(3), ALLIANCE_PASSIVE, true, Player(10))
    // -----Set Acolyte-----
    set udg_Acolyte01=gg_unit_uaco_0149
    call GroupAddUnitSimple(udg_Acolyte01, udg_StartingUnits)
    set udg_Acolyte02=gg_unit_uaco_0150
    call GroupAddUnitSimple(udg_Acolyte02, udg_StartingUnits)
    set udg_Acolyte03=gg_unit_uaco_0151
    call GroupAddUnitSimple(udg_Acolyte03, udg_StartingUnits)
    set udg_Acolyte04=gg_unit_uaco_0047
    call GroupAddUnitSimple(udg_Acolyte04, udg_StartingUnits)
    set udg_Acolyte05=gg_unit_uaco_0022
    call GroupAddUnitSimple(udg_Acolyte05, udg_StartingUnits)
    // -----Set Ghoul-----
    set udg_Ghoul01=gg_unit_uA00_0005
    call GroupAddUnitSimple(udg_Ghoul01, udg_StartingUnits)
    set udg_Ghoul02=gg_unit_ugho_0006
    call GroupAddUnitSimple(udg_Ghoul02, udg_StartingUnits)
    set udg_Ghoul03=gg_unit_ugho_0007
    call GroupAddUnitSimple(udg_Ghoul03, udg_StartingUnits)
    set udg_Ghoul04=gg_unit_ugho_0152
