    set gg_trg_Cinematic_Dialogue_F=CreateTrigger()
    call TriggerAddCondition(gg_trg_Cinematic_Dialogue_F, Condition(function Trig_Cinematic_Dialogue_F_Conditions))
    call TriggerAddAction(gg_trg_Cinematic_Dialogue_F, function Trig_Cinematic_Dialogue_F_Actions)
