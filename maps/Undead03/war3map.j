//===========================================================================
// Trigger: Cinematic Dialogue D
//
// Create and Introduce Meat Wagon
//===========================================================================
function Trig_Cinematic_Dialogue_D_Conditions takes nothing returns boolean
    if ( not ( udg_IntroCancel == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Dialogue_D_Func026001 takes nothing returns boolean
