//===========================================================================
// Trigger: Mission Start
//
// This trigger is fired when player comes into view of High Elf Village after the opening cinematic is either played or cancelled.
//===========================================================================
function Trig_Mission_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerHandicapXPBJ(Player(3), 40.00)
    // ----------
    call SetSkyModel(null)
    call SetTerrainFogExBJ(0, 1500.00, 3000.00, 0.00, 20.00, 40.00, 55.00)
    // ------Alliance Off-----
    call SetPlayerAllianceStateBJ(Player(3), Player(7), bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(Player(7), Player(3), bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(Player(2), Player(3), bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(Player(3), Player(2), bj_ALLIANCE_UNALLIED)
    // -
    call IssuePointOrderLocBJ(udg_Ghoul01, "move", GetRectCenter(gg_rct_02Starting_Town))
    call IssuePointOrderLocBJ(udg_Ghoul02, "move", GetRectCenter(gg_rct_02Starting_Town))
    call IssuePointOrderLocBJ(udg_Ghoul03, "move", GetRectCenter(gg_rct_02Starting_Town))
    call IssuePointOrderLocBJ(udg_Ghoul04, "move", GetRectCenter(gg_rct_02Starting_Town))
    call IssuePointOrderLocBJ(udg_Ghoul05, "move", GetRectCenter(gg_rct_02Starting_Town))
    call IssueBuildOrderByIdLocBJ(udg_Acolyte01, 'ugol', GetUnitLoc(gg_unit_ngol_0146))
    // ----------
    call StartCampaignAI(Player(4), "u03_Yellow.ai")
    call StartCampaignAI(Player(1), "u03_Blue.ai")
    call StartCampaignAI(Player(2), "u03_Teal.ai")
    // Invulnerable Elf Gate
    call SetDestructableInvulnerableBJ(gg_dest_LTe4_0021, true)
    // ----------
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_01Elfgate_Vis), 4.00)
    call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_01Elfgate_Vis))
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_044")
endfunction

//===========================================================================
function InitTrig_Mission_Start takes nothing returns nothing
    set gg_trg_Mission_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_Mission_Start, function Trig_Mission_Start_Actions)
endfunction

