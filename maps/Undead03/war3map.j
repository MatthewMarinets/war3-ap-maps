    call TriggerAddCondition(gg_trg_Discover_the_Gate_QUE, Condition(function Trig_Discover_the_Gate_QUE_Conditions))
    call TriggerAddAction(gg_trg_Discover_the_Gate_QUE, function Trig_Discover_the_Gate_QUE_Actions)
