    set gg_trg_Elfgate_Cinematic=CreateTrigger()
    call TriggerAddCondition(gg_trg_Elfgate_Cinematic, Condition(function Trig_Elfgate_Cinematic_Conditions))
    call TriggerAddAction(gg_trg_Elfgate_Cinematic, function Trig_Elfgate_Cinematic_Actions)
endfunction

