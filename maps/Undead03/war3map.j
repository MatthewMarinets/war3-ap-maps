    set gg_trg_Pink_Reveal=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Pink_Reveal, gg_rct_Pink_Discovered)
    call TriggerAddCondition(gg_trg_Pink_Reveal, Condition(function Trig_Pink_Reveal_Conditions))
    call TriggerAddAction(gg_trg_Pink_Reveal, function Trig_Pink_Reveal_Actions)
