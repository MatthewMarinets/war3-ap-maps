function InitTrig_Discover_the_Gate takes nothing returns nothing
    set gg_trg_Discover_the_Gate=CreateTrigger()
    call TriggerAddCondition(gg_trg_Discover_the_Gate, Condition(function Trig_Discover_the_Gate_Conditions))
    call TriggerAddAction(gg_trg_Discover_the_Gate, function Trig_Discover_the_Gate_Actions)
endfunction

