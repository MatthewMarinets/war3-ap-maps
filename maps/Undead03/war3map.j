    call TriggerAddAction(gg_trg_Purple_Blacken, function Trig_Purple_Blacken_Actions)
endfunction

//===========================================================================
// Trigger: Pink Reveal
//===========================================================================
function Trig_Pink_Reveal_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(3) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pink_Reveal_Func008001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func009001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func010001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func011001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func013001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func014001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func015001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Func016001 takes nothing returns boolean
    return ( udg_HINT == 0 )
endfunction

function Trig_Pink_Reveal_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Pink_Blacken)
    call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Pink_Vis), 600.00)
    set udg_PinkReveal=GetLastCreatedFogModifier()
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Pink_Vis), 2.00)
    call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Pink_Vis))
    // ----------
    if ( Trig_Pink_Reveal_Func008001() ) then
        call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Orange_Town_Vis), 650.00)
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func009001() ) then
        call DestroyFogModifier(GetLastCreatedFogModifier())
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func010001() ) then
        call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Orange_Town_Vis), 4.00)
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func011001() ) then
        call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Orange_Town_Vis))
    else
        call DoNothing()
    endif
    // -
    if ( Trig_Pink_Reveal_Func013001() ) then
        call CreateFogModifierRadiusLocBJ(true, Player(3), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Purple_Vis), 650.00)
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func014001() ) then
        call DestroyFogModifier(GetLastCreatedFogModifier())
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func015001() ) then
        call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Purple_Vis), 4.00)
    else
        call DoNothing()
    endif
    if ( Trig_Pink_Reveal_Func016001() ) then
        call SetCameraQuickPositionLocForPlayer(Player(3), GetRectCenter(gg_rct_Purple_Vis))
    else
        call DoNothing()
    endif
    // ----------
    call QueuedTriggerAddBJ(gg_trg_HINT, true)
endfunction

