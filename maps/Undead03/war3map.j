function Trig_Cinematic_Dialogue_C_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ----------
    call SetUnitFacingToFaceUnitTimed(udg_Necromancer01, udg_Arthas, 0.25)
    // ----------
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_03, Player(3), 0.00)
    call AttachSoundToUnitBJ(gg_snd_GhoulWarcry1, udg_Ghoul03)
    call SetSoundVolumeBJ(gg_snd_GhoulWarcry1, 40.00)
    call PlaySoundBJ(gg_snd_GhoulWarcry1)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_038", gg_snd_U03AArthas06, "TRIGSTR_039", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_C_Func011001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_Cinematic_Dialogue_C_Func014001() ) then
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Elfgate_01, Player(3), 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Elfgate_02, Player(3), 9.00)
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), Player(3), 'nemi', "TRIGSTR_040", GetUnitLoc(GetTriggerUnit()), gg_snd_U03BPriest07, "TRIGSTR_041", bj_TIMETYPE_ADD, 0.00, true)
    if ( Trig_Cinematic_Dialogue_C_Func019001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call SetUnitFacingToFaceUnitTimed(udg_Arthas, udg_Prisoner, 0.20)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Cinematic_04, Player(3), 0.00)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_043", gg_snd_U03BArthas08, "TRIGSTR_042", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Cinematic_Dialogue_C_Func026001() ) then
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.30)
    if ( Trig_Cinematic_Dialogue_C_Func028001() ) then
        return
    else
        call DoNothing()
    endif
    // ----------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call SetUnitPositionLoc(udg_Prisoner, GetRectCenter(gg_rct_01Priest_01_A))
    call IssuePointOrderLocBJ(udg_Necromancer01, "move", GetRectCenter(gg_rct_01Necromancer_01_B))
    call ConditionalTriggerExecute(gg_trg_Cinematic_Dialogue_D)
endfunction

