function Trig_Setup_Sylvanas_Actions takes nothing returns nothing
    set udg_Sylvanas=gg_unit_Hvwd_0090
    call SetUnitManaBJ(udg_Sylvanas, GetUnitStateSwap(UNIT_STATE_MAX_MANA, udg_Sylvanas))
    call SetHeroLevelBJ(udg_Sylvanas, 4, false)
