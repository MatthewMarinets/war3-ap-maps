// Trigger: Sylvanas Dialogue
//===========================================================================
function Trig_Sylvanas_Dialogue_Conditions takes nothing returns boolean
    if ( not ( udg_GAMEOVER == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sylvanas_Dialogue_Func008001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Arthas) == true )
endfunction

function Trig_Sylvanas_Dialogue_Func009001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Sylvanas) == true )
endfunction

function Trig_Sylvanas_Dialogue_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_SylvanasPoint=GetUnitLoc(udg_Sylvanas)
    call SmartCameraPanBJ(Player(3), udg_SylvanasPoint, 0.5)
    call SetCameraQuickPositionLocForPlayer(Player(3), udg_SylvanasPoint)
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Sylvanas, "TRIGSTR_132", gg_snd_U03ASylvanas12, "TRIGSTR_133", bj_TIMETYPE_ADD, 0, true)
    if ( Trig_Sylvanas_Dialogue_Func008001() ) then
        call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Arthas, "TRIGSTR_179", gg_snd_U03AArthas13, "TRIGSTR_180", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    if ( Trig_Sylvanas_Dialogue_Func009001() ) then
        call TransmissionFromUnitWithNameBJ(GetPlayersAll(), udg_Sylvanas, "TRIGSTR_229", gg_snd_U03BSylvanas14, "TRIGSTR_230", bj_TIMETYPE_ADD, 0, true)
    else
        call DoNothing()
    endif
    call VolumeGroupResetBJ()
    call TriggerSleepAction(10.00)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

